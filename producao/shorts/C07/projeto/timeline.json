  "captions": [
    {
      "start": 0.0,
      "end": 1.47,
      "text": "O detalhe está fora do carro."
    },
    {
      "start": 2.22,
      "end": 4.27,
      "text": "Na imagem de GTA seis, tem moto,"
    },
    {
      "start": 4.58,
      "end": 5.45,
      "text": "gente empinando,"
    },
    {
      "start": 5.82,
      "end": 7.84,
      "text": "outros veículos e pilares pintados sob o"
    },
    {
      "start": 7.84,
      "end": 8.69,
      "text": "viaduto."
    },
    {
      "start": 9.02,
      "end": 10.7,
      "text": "O cenário quase encosta no seu ombro"
    },
    {
      "start": 10.7,
      "end": 12.07,
      "text": "pedindo pra entrar na conversa."
    },
    {
      "start": 12.66,
      "end": 14.68,
      "text": "Compare com a foto promocional do Cheetah"
    },
    {
      "start": 14.68,
      "end": 16.96,
      "text": "em GTA cinco, divulgada em dois mil"
    },
    {
      "start": 16.96,
      "end": 17.81,
      "text": "e doze."
    },
    {
      "start": 18.02,
      "end": 19.95,
      "text": "A traseira ocupa boa parte do quadro."
    },
    {
      "start": 20.38,
      "end": 22.32,
      "text": "Aerofólio e fumaça junto dos pneus"
    },
    {
      "start": 22.32,
      "end": 24.1,
      "text": "deixam bem claro quem é a estrela"
    },
    {
      "start": 24.1,
      "end": 24.95,
      "text": "daquela imagem."
    },
    {
      "start": 25.36,
      "end": 26.57,
      "text": "Na cena de Vice City,"
    },
    {
      "start": 26.92,
      "end": 28.09,
      "text": "o automóvel vem pra frente,"
    },
    {
      "start": 28.54,
      "end": 30.54,
      "text": "mas divide espaço com gente e com"
    },
    {
      "start": 30.54,
      "end": 31.41,
      "text": "a identidade da rua."
    },
    {
      "start": 32.1,
      "end": 33.74,
      "text": "O lugar ajuda a despertar a vontade"
    },
    {
      "start": 33.74,
      "end": 34.73,
      "text": "de estar ali,"
    },
    {
      "start": 35.42,
      "end": 36.97,
      "text": "além da vontade de dirigir."
    },
    {
      "start": 37.74,
      "end": 39.72,
      "text": "Recortar só a lataria seria como tirar"
    },
    {
      "start": 39.72,
      "end": 41.62,
      "text": "a foto de um churrasco e apagar"
    },
    {
      "start": 41.62,
      "end": 43.47,
      "text": "os convidados pra avaliar a churrasqueira."
    },
    {
      "start": 44.22,
      "end": 45.47,
      "text": "Você até entende o equipamento."
    },
    {
      "start": 46.22,
      "end": 47.85,
      "text": "Perdeu um pedaço considerável do evento."
    },
    {
      "start": 48.7,
      "end": 50.22,
      "text": "Isso não prova a quantidade de pessoas"
    },
    {
      "start": 50.22,
      "end": 52.14,
      "text": "em todo o jogo nem permite comparar"
    },
    {
      "start": 52.14,
      "end": 52.99,
      "text": "a desempenho."
    },
    {
      "start": 53.2,
      "end": 54.94,
      "text": "São imagens promocionais com enquadramentos"
    },
    {
      "start": 54.94,
      "end": 55.79,
      "text": "diferentes."
    },
    {
      "start": 56.2,
      "end": 58.02,
      "text": "A comparação aqui é sobre o que"
    },
    {
      "start": 58.02,
      "end": 59.61,
      "text": "cada foto escolheu destacar."
    },
    {
      "start": 60.22,
      "end": 61.69,
      "text": "Uma concentra o olhar no carro."
    },
    {
      "start": 62.28,
      "end": 64.02,
      "text": "A outra abre espaço pra relação entre"
    },
    {
      "start": 64.02,
      "end": 65.81,
      "text": "carro, pessoas e bairro."
    },
    {
      "start": 66.42,
      "end": 67.88,
      "text": "Volta à imagem e acompanha as bordas"
    },
    {
      "start": 67.88,
      "end": 69.21,
      "text": "antes de ampliar os faróis."
    },
    {
      "start": 70.18,
      "end": 71.0,
      "text": "Porque..."
    }
  ]
}