  "captions": [
    {
      "start": 0.0,
      "end": 1.62,
      "text": "Um golpe errado não revela quem vai"
    },
    {
      "start": 1.62,
      "end": 2.47,
      "text": "trair quem."
    },
    {
      "start": 2.64,
      "end": 4.05,
      "text": "Na premissa de GTA seis,"
    },
    {
      "start": 4.4,
      "end": 6.02,
      "text": "Jason e Lucia enfrentam um problema que"
    },
    {
      "start": 6.02,
      "end": 8.1,
      "text": "cresce e precisam contar um com o"
    },
    {
      "start": 8.1,
      "end": 8.95,
      "text": "outro."
    },
    {
      "start": 9.02,
      "end": 10.99,
      "text": "Isso coloca confiança no centro da leitura."
    },
    {
      "start": 11.6,
      "end": 14.28,
      "text": "Mas existe uma distância enorme entre identificar"
    },
    {
      "start": 14.28,
      "end": 16.22,
      "text": "essa tensão e anunciar o desfecho da"
    },
    {
      "start": 16.22,
      "end": 17.07,
      "text": "relação."
    },
    {
      "start": 17.8,
      "end": 19.25,
      "text": "Aqui acontece o salto:"
    },
    {
      "start": 19.62,
      "end": 21.44,
      "text": "você encontra uma história sobre dependência"
    },
    {
      "start": 21.44,
      "end": 23.16,
      "text": "e imagina que ela só pode terminar"
    },
    {
      "start": 23.16,
      "end": 24.01,
      "text": "em traição."
    },
    {
      "start": 24.3,
      "end": 26.42,
      "text": "É uma possibilidade de interpretação, não"
    },
    {
      "start": 26.42,
      "end": 28.01,
      "text": "uma conclusão entregue pela premissa."
    },
    {
      "start": 28.78,
      "end": 30.9,
      "text": "O mesmo ponto de partida permite conflitos"
    },
    {
      "start": 30.9,
      "end": 31.85,
      "text": "que ainda não conhecemos."
    },
    {
      "start": 32.68,
      "end": 34.68,
      "text": "Mas dá para investigar a dupla sem"
    },
    {
      "start": 34.68,
      "end": 36.03,
      "text": "fingir que o final vazou."
    },
    {
      "start": 36.6,
      "end": 38.62,
      "text": "Troque a pergunta sobre quem trai por"
    },
    {
      "start": 38.62,
      "end": 39.47,
      "text": "outra:"
    },
    {
      "start": 39.5,
      "end": 40.98,
      "text": "o que cada um pode perder ao"
    },
    {
      "start": 40.98,
      "end": 41.83,
      "text": "confiar?"
    },
    {
      "start": 42.26,
      "end": 43.94,
      "text": "Agora você tem um critério para observar"
    },
    {
      "start": 43.94,
      "end": 44.79,
      "text": "decisões,"
    },
    {
      "start": 44.86,
      "end": 46.86,
      "text": "hesitações e consequências conforme houver"
    },
    {
      "start": 46.86,
      "end": 47.87,
      "text": "evidência sobre elas."
    },
    {
      "start": 48.36,
      "end": 50.88,
      "text": "Só que o cuidado precisa continuar na"
    },
    {
      "start": 50.88,
      "end": 51.68,
      "text": "montagem."
    },
    {
      "start": 51.68,
      "end": 53.38,
      "text": "Colocar uma expressão séria ao lado de"
    },
    {
      "start": 53.38,
      "end": 55.42,
      "text": "uma frase sobre traição pode fazer a"
    },
    {
      "start": 55.42,
      "end": 57.01,
      "text": "hipótese parecer uma revelação."
    },
    {
      "start": 57.74,
      "end": 59.76,
      "text": "O vídeo deve deixar claro quando descreve"
    },
    {
      "start": 59.76,
      "end": 61.88,
      "text": "informação divulgada e quando propõe uma"
    },
    {
      "start": 61.88,
      "end": 63.49,
      "text": "leitura possível para o espectador."
    },
    {
      "start": 64.48,
      "end": 66.78,
      "text": "A recompensa é conseguir discutir a história"
    },
    {
      "start": 66.78,
      "end": 68.43,
      "text": "sem precisar fabricar um spoiler."
    },
    {
      "start": 69.0,
      "end": 70.85,
      "text": "A confiança já oferece conflito suficiente:"
    },
    {
      "start": 71.52,
      "end": 73.82,
      "text": "depender de alguém torna cada decisão compartilhada"
    },
    {
      "start": 73.82,
      "end": 74.67,
      "text": "mais importante."
    },
    {
      "start": 75.3,
      "end": 77.56,
      "text": "O que ela não oferece, sozinha, é"
    },
    {
      "start": 77.56,
      "end": 78.41,
      "text": "o nome de um traidor."
    },
    {
      "start": 78.98,
      "end": 79.64,
      "text": "Porque..."
    }
  ]
}