  "captions": [
    {
      "start": 0.0,
      "end": 1.73,
      "text": "Estão avaliando gráficos no pôster."
    },
    {
      "start": 2.3,
      "end": 4.14,
      "text": "Uma imagem oficial de GTA seis pode"
    },
    {
      "start": 4.14,
      "end": 5.4,
      "text": "ser um desenho."
    },
    {
      "start": 5.4,
      "end": 7.88,
      "text": "Parece óbvio até alguém ampliar o rosto"
    },
    {
      "start": 7.88,
      "end": 9.68,
      "text": "no pôster pra avaliar os gráficos do"
    },
    {
      "start": 9.68,
      "end": 10.53,
      "text": "jogo."
    },
    {
      "start": 10.82,
      "end": 12.18,
      "text": "Daqui a pouco eu está medindo o"
    },
    {
      "start": 12.18,
      "end": 14.27,
      "text": "desempenho do console pela qualidade da moldura."
    },
    {
      "start": 15.3,
      "end": 17.07,
      "text": "Olha a arte de Jason e Lucia"
    },
    {
      "start": 17.14,
      "end": 18.96,
      "text": "junto do carro, com céu rosa e"
    },
    {
      "start": 18.96,
      "end": 19.81,
      "text": "palmeiras."
    },
    {
      "start": 20.14,
      "end": 22.46,
      "text": "Ela tem traço, cores e uma composição"
    },
    {
      "start": 22.46,
      "end": 24.31,
      "text": "pensada pra representar os personagens."
    },
    {
      "start": 24.88,
      "end": 26.72,
      "text": "A própria biblioteca separa esse material"
    },
    {
      "start": 26.72,
      "end": 27.75,
      "text": "das capturas de tela."
    },
    {
      "start": 28.3,
      "end": 30.64,
      "text": "Uma captura permite observar como aquele"
    },
    {
      "start": 30.64,
      "end": 32.51,
      "text": "quadro do jogo foi apresentado."
    },
    {
      "start": 32.82,
      "end": 35.11,
      "text": "A ilustração mostra escolhas do artista."
    },
    {
      "start": 35.78,
      "end": 37.9,
      "text": "As duas são oficiais, mas ajudam a"
    },
    {
      "start": 37.9,
      "end": 39.15,
      "text": "responder perguntas diferentes."
    },
    {
      "start": 40.26,
      "end": 42.36,
      "text": "Usar o desenho pra avaliar os gráficos"
    },
    {
      "start": 42.36,
      "end": 43.64,
      "text": "é como olhar a planta de um"
    },
    {
      "start": 43.64,
      "end": 46.13,
      "text": "apartamento e elogiar a ventilação."
    },
    {
      "start": 46.76,
      "end": 48.47,
      "text": "Tem uma seta azul atravessando a sala."
    },
    {
      "start": 49.02,
      "end": 50.71,
      "text": "Deve entrar um vento maravilhoso."
    },
    {
      "start": 51.6,
      "end": 53.21,
      "text": "E uma captura também tem limite:"
    },
    {
      "start": 53.5,
      "end": 54.32,
      "text": "mostra um instante."
    },
    {
      "start": 54.32,
      "end": 56.74,
      "text": "Sozinha, ela não demonstra como o jogo"
    },
    {
      "start": 56.74,
      "end": 58.71,
      "text": "roda em movimento ou responde ao controle."
    },
    {
      "start": 59.38,
      "end": 61.08,
      "text": "Pra essas perguntas, precisamos de material"
    },
    {
      "start": 61.08,
      "end": 62.67,
      "text": "que mostre justamente isso."
    },
    {
      "start": 63.48,
      "end": 65.73,
      "text": "Antes de discutir cada poro do personagem,"
    },
    {
      "start": 66.06,
      "end": 67.54,
      "text": "confere de onde veio a imagem e"
    },
    {
      "start": 67.54,
      "end": 68.99,
      "text": "em qual categoria foi publicada."
    },
    {
      "start": 69.8,
      "end": 71.46,
      "text": "Esse passo economiza uma discussão inteira"
    },
    {
      "start": 71.46,
      "end": 72.75,
      "text": "baseada no arquivo errado."
    },
    {
      "start": 73.24,
      "end": 74.09,
      "text": "Afinal..."
    }
  ]
}