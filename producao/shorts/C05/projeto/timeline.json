  "captions": [
    {
      "start": 0.0,
      "end": 1.37,
      "text": "Gameplay confirmado."
    },
    {
      "start": 1.74,
      "end": 3.63,
      "text": "Mas qual dessas cenas?"
    },
    {
      "start": 4.7,
      "end": 6.74,
      "text": "A Rockstar descreve o Trailer dois de"
    },
    {
      "start": 6.74,
      "end": 9.2,
      "text": "GTA seis como metade gameplay e metade"
    },
    {
      "start": 9.2,
      "end": 10.43,
      "text": "cenas cinematográficas."
    },
    {
      "start": 10.8,
      "end": 13.4,
      "text": "Isso confirma a mistura, mas não entrega"
    },
    {
      "start": 13.4,
      "end": 15.49,
      "text": "uma legenda identificando cada trecho."
    },
    {
      "start": 16.28,
      "end": 18.68,
      "text": "Uma câmera atrás do personagem lembra o"
    },
    {
      "start": 18.68,
      "end": 19.53,
      "text": "momento de jogar."
    },
    {
      "start": 19.86,
      "end": 22.2,
      "text": "Só que uma sequência pronta também pode"
    },
    {
      "start": 22.2,
      "end": 23.05,
      "text": "usar esse ângulo."
    },
    {
      "start": 23.68,
      "end": 25.55,
      "text": "A posição da câmera é uma pista."
    },
    {
      "start": 25.9,
      "end": 27.58,
      "text": "Não é um controle aparecendo na mão"
    },
    {
      "start": 27.58,
      "end": 30.04,
      "text": "de alguém. A Anúncio de apartamento também"
    },
    {
      "start": 30.04,
      "end": 30.89,
      "text": "sabe usar ângulo."
    },
    {
      "start": 31.46,
      "end": 32.93,
      "text": "Na foto, cabe uma festa."
    },
    {
      "start": 33.46,
      "end": 35.66,
      "text": "Você visita e descobre que, pra abrir"
    },
    {
      "start": 35.66,
      "end": 37.95,
      "text": "a geladeira, precisa pedir licença pra cozinha."
    },
    {
      "start": 38.7,
      "end": 40.6,
      "text": "O enquadramento pode sugerir mais do que"
    },
    {
      "start": 40.6,
      "end": 41.45,
      "text": "demonstra."
    },
    {
      "start": 41.72,
      "end": 43.56,
      "text": "Imagina uma cena com alguém entrando num"
    },
    {
      "start": 43.56,
      "end": 44.41,
      "text": "carro."
    },
    {
      "start": 44.64,
      "end": 45.98,
      "text": "Ver a porta abrir e o carro"
    },
    {
      "start": 45.98,
      "end": 47.28,
      "text": "sair e não explica se o jogador"
    },
    {
      "start": 47.28,
      "end": 49.21,
      "text": "escolheu aquele momento e aquele destino."
    },
    {
      "start": 49.86,
      "end": 51.25,
      "text": "Esse exemplo é hipotético:"
    },
    {
      "start": 51.68,
      "end": 53.82,
      "text": "serve pra separar a ação mostrada de"
    },
    {
      "start": 53.82,
      "end": 56.88,
      "text": "decisão disponível. A declaração oficial"
    },
    {
      "start": 56.88,
      "end": 58.11,
      "text": "resolve a dúvida geral."
    },
    {
      "start": 58.82,
      "end": 61.12,
      "text": "Pra classificar uma cena específica, precisamos"
    },
    {
      "start": 61.12,
      "end": 62.89,
      "text": "de informação sobre aquela cena."
    },
    {
      "start": 63.52,
      "end": 65.6,
      "text": "Não dá pra distribuir certeza só porque"
    },
    {
      "start": 65.6,
      "end": 66.71,
      "text": "o movimento parece familiar,"
    },
    {
      "start": 67.26,
      "end": 69.16,
      "text": "nem chamar tudo de sequência pronta porque"
    },
    {
      "start": 69.16,
      "end": 70.01,
      "text": "ficou bonito."
    },
    {
      "start": 70.74,
      "end": 72.05,
      "text": "Empolgação é permitida."
    },
    {
      "start": 72.54,
      "end": 74.58,
      "text": "A nossa precisa apenas parar antes de"
    },
    {
      "start": 74.58,
      "end": 76.1,
      "text": "inventar a legenda que a Rockstar não"
    },
    {
      "start": 76.1,
      "end": 76.95,
      "text": "colocou."
    },
    {
      "start": 77.34,
      "end": 78.89,
      "text": "A resposta geral o existe;"
    },
    {
      "start": 79.32,
      "end": 81.4,
      "text": "a identificação de cada trecho é outra"
    },
    {
      "start": 81.4,
      "end": 83.53,
      "text": "pergunta. Então..."
    }
  ]
}