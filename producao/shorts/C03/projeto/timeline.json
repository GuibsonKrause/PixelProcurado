  "captions": [
    {
      "start": 0.0,
      "end": 1.73,
      "text": "Esse abraço tem polícia no fundo."
    },
    {
      "start": 2.48,
      "end": 4.64,
      "text": "No recorte, temos o casal e o"
    },
    {
      "start": 4.64,
      "end": 5.67,
      "text": "sol entre os rostos."
    },
    {
      "start": 5.98,
      "end": 7.72,
      "text": "Parece que falta só uma legenda sobre"
    },
    {
      "start": 7.72,
      "end": 8.97,
      "text": "encontrar a pessoa certa."
    },
    {
      "start": 9.72,
      "end": 11.32,
      "text": "A pessoa certa veio com um contexto"
    },
    {
      "start": 11.32,
      "end": 12.33,
      "text": "bem complicado."
    },
    {
      "start": 13.0,
      "end": 15.4,
      "text": "Na arte inteira, aparecem barcos da polícia"
    },
    {
      "start": 15.4,
      "end": 16.25,
      "text": "e um helicóptero."
    },
    {
      "start": 16.84,
      "end": 19.12,
      "text": "Esses elementos dividem espaço com o casal"
    },
    {
      "start": 19.12,
      "end": 20.75,
      "text": "e mudam o clima do abraço."
    },
    {
      "start": 21.26,
      "end": 23.86,
      "text": "O romance continua ali, cercado por sinais"
    },
    {
      "start": 23.86,
      "end": 26.34,
      "text": "de perigo. É como escolher a foto"
    },
    {
      "start": 26.34,
      "end": 28.38,
      "text": "perfeita de uma viagem e cortar o"
    },
    {
      "start": 28.38,
      "end": 29.91,
      "text": "guincho que estava buscando seu carro."
    },
    {
      "start": 30.24,
      "end": 31.55,
      "text": "O momento bonito aconteceu."
    },
    {
      "start": 32.0,
      "end": 33.67,
      "text": "Só não conta a história inteira."
    },
    {
      "start": 34.36,
      "end": 36.06,
      "text": "E o guincho também participou bastante das"
    },
    {
      "start": 36.06,
      "end": 36.91,
      "text": "férias."
    },
    {
      "start": 37.32,
      "end": 39.72,
      "text": "Aqui, a leitura vem da posição dos"
    },
    {
      "start": 39.72,
      "end": 40.85,
      "text": "elementos no desenho."
    },
    {
      "start": 41.42,
      "end": 43.09,
      "text": "O casal ocupa o centro;"
    },
    {
      "start": 43.76,
      "end": 45.86,
      "text": "a perseguição sugerida pelo entorno coloca"
    },
    {
      "start": 45.86,
      "end": 47.31,
      "text": "a pressão nessa proximidade."
    },
    {
      "start": 47.96,
      "end": 50.21,
      "text": "Isso não revela quando uma cena acontece,"
    },
    {
      "start": 50.54,
      "end": 52.42,
      "text": "quem trai alguém ou qual missão vem"
    },
    {
      "start": 52.42,
      "end": 53.27,
      "text": "depois."
    },
    {
      "start": 53.52,
      "end": 56.07,
      "text": "O detalhe interessante é o contraste:"
    },
    {
      "start": 56.44,
      "end": 58.94,
      "text": "duas pessoas próximas, com um mundo complicado"
    },
    {
      "start": 58.94,
      "end": 59.79,
      "text": "ao redor."
    },
    {
      "start": 60.3,
      "end": 62.42,
      "text": "Ao fechar o recorte, você destaca o"
    },
    {
      "start": 62.42,
      "end": 63.27,
      "text": "afeto."
    },
    {
      "start": 63.4,
      "end": 64.25,
      "text": "Ao abrir,"
    },
    {
      "start": 64.34,
      "end": 66.29,
      "text": "deixa o perigo participar da mesma imagem."
    },
    {
      "start": 67.02,
      "end": 68.82,
      "text": "Antes de usar essa arte como prova"
    },
    {
      "start": 68.82,
      "end": 69.71,
      "text": "de uma teoria,"
    },
    {
      "start": 70.2,
      "end": 71.31,
      "text": "confere o quadro inteiro."
    },
    {
      "start": 71.84,
      "end": 73.54,
      "text": "O recorte pode mudar bastante a pergunta"
    },
    {
      "start": 73.54,
      "end": 74.39,
      "text": "que você faz."
    },
    {
      "start": 74.84,
      "end": 75.69,
      "text": "Porque..."
    }
  ]
}