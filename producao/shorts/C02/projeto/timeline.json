  "captions": [
    {
      "start": 0.0,
      "end": 2.2,
      "text": "Jason e Lucia podem querer melhorar de"
    },
    {
      "start": 2.2,
      "end": 3.31,
      "text": "vida e colidir."
    },
    {
      "start": 3.88,
      "end": 6.02,
      "text": "O contraste está nas apresentações de GTA"
    },
    {
      "start": 6.02,
      "end": 6.87,
      "text": "seis:"
    },
    {
      "start": 6.92,
      "end": 8.29,
      "text": "Jason quer uma vida fácil;"
    },
    {
      "start": 8.66,
      "end": 9.69,
      "text": "Lucia tem um plano."
    },
    {
      "start": 10.34,
      "end": 12.36,
      "text": "Parece uma combinação perfeita, até você"
    },
    {
      "start": 12.36,
      "end": 14.44,
      "text": "separar duas coisas que costumam andar juntas"
    },
    {
      "start": 14.44,
      "end": 15.29,
      "text": "na nossa cabeça:"
    },
    {
      "start": 16.04,
      "end": 18.39,
      "text": "o destino desejado e o caminho escolhido."
    },
    {
      "start": 19.42,
      "end": 21.56,
      "text": "Mas imagine uma oportunidade que promete"
    },
    {
      "start": 21.56,
      "end": 22.97,
      "text": "dinheiro e aumenta o risco."
    },
    {
      "start": 23.44,
      "end": 25.12,
      "text": "Isso é um exemplo, não uma missão"
    },
    {
      "start": 25.12,
      "end": 25.97,
      "text": "anunciada."
    },
    {
      "start": 26.5,
      "end": 28.61,
      "text": "Quem procura sossego pode querer recuar."
    },
    {
      "start": 29.34,
      "end": 30.68,
      "text": "Quem enxerga uma chance de assumir o"
    },
    {
      "start": 30.68,
      "end": 32.29,
      "text": "controle pode querer avançar."
    },
    {
      "start": 32.98,
      "end": 35.13,
      "text": "O mesmo prêmio cria decisões opostas."
    },
    {
      "start": 35.9,
      "end": 37.88,
      "text": "Só que a premissa coloca outra pressão"
    },
    {
      "start": 37.88,
      "end": 38.73,
      "text": "nessa conta:"
    },
    {
      "start": 39.0,
      "end": 39.93,
      "text": "um golpe dá errado,"
    },
    {
      "start": 40.28,
      "end": 42.32,
      "text": "o problema cresce e os dois precisam"
    },
    {
      "start": 42.32,
      "end": 43.37,
      "text": "contar um com o outro."
    },
    {
      "start": 44.02,
      "end": 45.82,
      "text": "Nesse cenário, o discordar deixa de ser"
    },
    {
      "start": 45.82,
      "end": 46.89,
      "text": "apenas uma conversa."
    },
    {
      "start": 47.24,
      "end": 48.5,
      "text": "A escolha de um pode cobrar um"
    },
    {
      "start": 48.5,
      "end": 49.35,
      "text": "preço do dos dois."
    },
    {
      "start": 50.34,
      "end": 52.28,
      "text": "Agora repare no que isso muda ao"
    },
    {
      "start": 52.28,
      "end": 53.13,
      "text": "acompanhar a dupla."
    },
    {
      "start": 53.7,
      "end": 55.76,
      "text": "Mais interessante que apostar numa traição"
    },
    {
      "start": 55.76,
      "end": 58.29,
      "text": "é observar quem propõe o próximo passo,"
    },
    {
      "start": 58.74,
      "end": 60.4,
      "text": "quem hesita e o que cada um"
    },
    {
      "start": 60.4,
      "end": 61.25,
      "text": "teme perder."
    },
    {
      "start": 61.84,
      "end": 63.75,
      "text": "Essa é a minha leitura do conflito,"
    },
    {
      "start": 64.02,
      "end": 65.33,
      "text": "não uma previsão do final."
    },
    {
      "start": 66.46,
      "end": 68.82,
      "text": "Gostar de alguém pode aproximar os destinos"
    },
    {
      "start": 68.82,
      "end": 70.25,
      "text": "sem alinhar as decisões."
    },
    {
      "start": 70.94,
      "end": 72.62,
      "text": "A tensão começa quando uma chance de"
    },
    {
      "start": 72.62,
      "end": 75.34,
      "text": "melhorar a vida exige justamente o risco"
    },
    {
      "start": 75.34,
      "end": 76.47,
      "text": "que o outro quer evitar."
    },
    {
      "start": 77.18,
      "end": 78.03,
      "text": "Por isso..."
    }
  ]
}