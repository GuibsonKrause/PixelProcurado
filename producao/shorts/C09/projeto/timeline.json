  "captions": [
    {
      "start": 0.0,
      "end": 0.85,
      "text": "Mesma água."
    },
    {
      "start": 1.42,
      "end": 2.85,
      "text": "Outro nível de desconfiança."
    },
    {
      "start": 3.52,
      "end": 5.07,
      "text": "Nas Keys, o mar aberto,"
    },
    {
      "start": 5.44,
      "end": 7.0,
      "text": "as ilhas e a ponte deixam olhar"
    },
    {
      "start": 7.0,
      "end": 7.85,
      "text": "ir longe."
    },
    {
      "start": 8.22,
      "end": 10.99,
      "text": "Em Grassrivers, o barco aparece entre árvores,"
    },
    {
      "start": 11.24,
      "end": 12.71,
      "text": "num corredor de água mais fechado."
    },
    {
      "start": 13.5,
      "end": 14.35,
      "text": "Num lugar,"
    },
    {
      "start": 14.58,
      "end": 16.16,
      "text": "eu fico escolhendo onde parar pra olhar"
    },
    {
      "start": 16.16,
      "end": 17.01,
      "text": "para a paisagem."
    },
    {
      "start": 17.48,
      "end": 18.33,
      "text": "No outro,"
    },
    {
      "start": 18.42,
      "end": 20.0,
      "text": "presto atenção no que não consigo enxergar"
    },
    {
      "start": 20.0,
      "end": 20.99,
      "text": "depois da vegetação."
    },
    {
      "start": 21.92,
      "end": 23.69,
      "text": "A viagem continua de barco."
    },
    {
      "start": 24.12,
      "end": 25.58,
      "text": "A minha confiança que ficou na última"
    },
    {
      "start": 25.58,
      "end": 26.43,
      "text": "ponte."
    },
    {
      "start": 27.06,
      "end": 29.89,
      "text": "É a sensação que esses enquadramentos passam."
    },
    {
      "start": 30.32,
      "end": 32.76,
      "text": "A foto das Keys oferece espaço e"
    },
    {
      "start": 32.76,
      "end": 33.61,
      "text": "horizonte."
    },
    {
      "start": 33.98,
      "end": 35.93,
      "text": "A de Grassrivers esconde partes do caminho."
    },
    {
      "start": 36.74,
      "end": 38.3,
      "text": "A abertura do cenário muda a nossa"
    },
    {
      "start": 38.3,
      "end": 40.12,
      "text": "expectativa antes de qualquer personagem"
    },
    {
      "start": 40.12,
      "end": 41.11,
      "text": "dizer alguma coisa."
    },
    {
      "start": 42.02,
      "end": 44.4,
      "text": "Parece a diferença entre escolher uma casa"
    },
    {
      "start": 44.4,
      "end": 46.9,
      "text": "de férias pela varanda e visitar outra"
    },
    {
      "start": 46.9,
      "end": 47.99,
      "text": "levando uma lanterna"
    },
    {
      "start": 48.5,
      "end": 49.35,
      "text": "por precaução."
    },
    {
      "start": 50.26,
      "end": 51.69,
      "text": "A segunda pode ser ótima."
    },
    {
      "start": 52.2,
      "end": 53.64,
      "text": "Você só vai conferir o barulho no"
    },
    {
      "start": 53.64,
      "end": 55.25,
      "text": "quintal com menos entusiasmo."
    },
    {
      "start": 56.32,
      "end": 59.48,
      "text": "Isso não confirma a perseguição, emboscada"
    },
    {
      "start": 59.48,
      "end": 61.21,
      "text": "nem sistema de furtividade."
    },
    {
      "start": 62.1,
      "end": 63.69,
      "text": "A análise é das imagens:"
    },
    {
      "start": 64.28,
      "end": 65.51,
      "text": "o que fica visível,"
    },
    {
      "start": 65.94,
      "end": 67.7,
      "text": "o que é encoberto e como isso"
    },
    {
      "start": 67.7,
      "end": 68.55,
      "text": "orienta o nosso olhar."
    },
    {
      "start": 69.66,
      "end": 71.58,
      "text": "As duas regiões usam água como parte"
    },
    {
      "start": 71.58,
      "end": 72.73,
      "text": "importante da paisagem,"
    },
    {
      "start": 73.18,
      "end": 75.09,
      "text": "mas criam impressões bem diferentes."
    },
    {
      "start": 76.1,
      "end": 78.06,
      "text": "Nas Keys, procuro o horizonte."
    },
    {
      "start": 78.06,
      "end": 81.01,
      "text": "Em Grassrivers, examino a próxima curva."
    },
    {
      "start": 81.4,
      "end": 82.31,
      "text": "Porque..."
    }
  ]
}