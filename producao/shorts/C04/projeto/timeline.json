  "captions": [
    {
      "start": 0.0,
      "end": 1.93,
      "text": "Sua nostalgia de GTA tem truque."
    },
    {
      "start": 2.18,
      "end": 3.565,
      "text": "Vice City saiu em dois mil e"
    },
    {
      "start": 3.565,
      "end": 4.26,
      "text": "dois,"
    },
    {
      "start": 4.26,
      "end": 5.713,
      "text": "mas a história acontece em mil novecentos"
    },
    {
      "start": 5.713,
      "end": 6.563,
      "text": "e oitenta e seis."
    },
    {
      "start": 7.24,
      "end": 8.96,
      "text": "A terceira época é a sua vida"
    },
    {
      "start": 8.96,
      "end": 9.95,
      "text": "quando você jogou."
    },
    {
      "start": 10.94,
      "end": 13.12,
      "text": "Você pode lembrar do rádio, das palmeiras"
    },
    {
      "start": 13.12,
      "end": 13.97,
      "text": "e de Tommy."
    },
    {
      "start": 14.58,
      "end": 16.66,
      "text": "Ou daquela tarde que conseguiu dirigir sem"
    },
    {
      "start": 16.66,
      "end": 17.51,
      "text": "rumo por horas."
    },
    {
      "start": 18.7,
      "end": 20.34,
      "text": "Hoje, às vezes, o máximo de liberdade"
    },
    {
      "start": 20.34,
      "end": 22.25,
      "text": "é escolher qual compromisso vai atrasar."
    },
    {
      "start": 23.34,
      "end": 25.66,
      "text": "Por isso, pedir a mesma sensação exige"
    },
    {
      "start": 25.66,
      "end": 26.55,
      "text": "separar as coisas."
    },
    {
      "start": 27.12,
      "end": 29.11,
      "text": "A Rockstar pode reconstruir uma avenida."
    },
    {
      "start": 29.64,
      "end": 31.98,
      "text": "Restaurar sua tarde sem obrigação já parece"
    },
    {
      "start": 31.98,
      "end": 34.58,
      "text": "um serviço que exigiria intervenção divina"
    },
    {
      "start": 34.58,
      "end": 36.61,
      "text": "e cancelamento de umas três reuniões."
    },
    {
      "start": 37.68,
      "end": 39.29,
      "text": "Nas imagens de GTA seis,"
    },
    {
      "start": 39.68,
      "end": 41.61,
      "text": "o excesso continua, com outra apresentação."
    },
    {
      "start": 42.56,
      "end": 44.39,
      "text": "As Real Dimez aparecem sobre um carro,"
    },
    {
      "start": 44.62,
      "end": 46.09,
      "text": "cercadas por gente filmando."
    },
    {
      "start": 47.1,
      "end": 49.1,
      "text": "A vontade de aparecer ganhou uma plateia"
    },
    {
      "start": 49.1,
      "end": 51.03,
      "text": "que também ajuda a espalhar o espetáculo."
    },
    {
      "start": 51.84,
      "end": 53.33,
      "text": "Todo mundo quer guardar o momento."
    },
    {
      "start": 53.6,
      "end": 55.37,
      "text": "Alguns já estão pensando na legenda."
    },
    {
      "start": 58.07,
      "end": 60.02,
      "text": "A cidade mudou, e nós também."
    },
    {
      "start": 60.99,
      "end": 63.01,
      "text": "Dá pra reconhecer uma identidade nas cores"
    },
    {
      "start": 63.01,
      "end": 64.93,
      "text": "e na ambição sem exigir que o"
    },
    {
      "start": 64.93,
      "end": 66.63,
      "text": "jogo devolva uma fase inteira da nossa"
    },
    {
      "start": 66.63,
      "end": 67.48,
      "text": "vida."
    },
    {
      "start": 68.01,
      "end": 69.91,
      "text": "Talvez o mais interessante seja reencontrar"
    },
    {
      "start": 69.91,
      "end": 71.89,
      "text": "algo familiar e perceber o que ficou"
    },
    {
      "start": 71.89,
      "end": 72.74,
      "text": "diferente."
    },
    {
      "start": 73.37,
      "end": 75.37,
      "text": "Até a nostalgia mistura lembranças que não"
    },
    {
      "start": 75.37,
      "end": 76.62,
      "text": "aconteceram na mesma data."
    },
    {
      "start": 77.01,
      "end": 77.86,
      "text": "Afinal..."
    }
  ]
}