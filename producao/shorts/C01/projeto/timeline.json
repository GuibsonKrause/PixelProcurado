  "captions": [
    {
      "start": 0.0,
      "end": 2.32,
      "text": "Uma data verdadeira pode te enganar sobre"
    },
    {
      "start": 2.32,
      "end": 3.17,
      "text": "GTA seis."
    },
    {
      "start": 3.66,
      "end": 5.54,
      "text": "Basta ela aparecer ao lado da plataforma"
    },
    {
      "start": 5.54,
      "end": 6.39,
      "text": "errada."
    },
    {
      "start": 6.7,
      "end": 7.79,
      "text": "Você vê um dia,"
    },
    {
      "start": 8.18,
      "end": 9.8,
      "text": "reconhece o nome do jogo e entende"
    },
    {
      "start": 9.8,
      "end": 11.23,
      "text": "que já pode marcar no calendário."
    },
    {
      "start": 11.7,
      "end": 13.2,
      "text": "Só que a informação pode ter perdido"
    },
    {
      "start": 13.2,
      "end": 15.21,
      "text": "justamente a parte que interessa para você."
    },
    {
      "start": 16.24,
      "end": 17.89,
      "text": "Aqui está a primeira armadilha:"
    },
    {
      "start": 18.32,
      "end": 20.55,
      "text": "anúncio de lançamento e anúncio de plataformas"
    },
    {
      "start": 20.76,
      "end": 22.05,
      "text": "precisam ser lidos juntos."
    },
    {
      "start": 22.84,
      "end": 24.65,
      "text": "Se a página cita determinados consoles,"
    },
    {
      "start": 25.1,
      "end": 26.79,
      "text": "aquela lista faz parte da notícia."
    },
    {
      "start": 27.4,
      "end": 29.52,
      "text": "Recortar só a data transforma uma informação"
    },
    {
      "start": 29.52,
      "end": 31.69,
      "text": "específica numa promessa muito maior."
    },
    {
      "start": 32.98,
      "end": 34.46,
      "text": "Mas encontrar o logo do seu aparelho"
    },
    {
      "start": 34.46,
      "end": 35.61,
      "text": "também exige contexto."
    },
    {
      "start": 36.48,
      "end": 38.44,
      "text": "Um trailer capturado em determinado console"
    },
    {
      "start": 38.44,
      "end": 40.61,
      "text": "informa onde aquele vídeo foi produzido."
    },
    {
      "start": 41.38,
      "end": 42.47,
      "text": "Isso, sozinho,"
    },
    {
      "start": 42.8,
      "end": 45.1,
      "text": "não define exclusividade nem calendário de"
    },
    {
      "start": 45.1,
      "end": 45.95,
      "text": "todas as versões."
    },
    {
      "start": 46.66,
      "end": 47.73,
      "text": "São perguntas diferentes,"
    },
    {
      "start": 48.16,
      "end": 49.73,
      "text": "que precisam de respostas diferentes."
    },
    {
      "start": 50.62,
      "end": 52.24,
      "text": "Agora vem o teste que resolve a"
    },
    {
      "start": 52.24,
      "end": 53.09,
      "text": "confusão:"
    },
    {
      "start": 53.34,
      "end": 54.53,
      "text": "procure a página oficial,"
    },
    {
      "start": 55.14,
      "end": 56.36,
      "text": "leia a data com a lista de"
    },
    {
      "start": 56.36,
      "end": 58.98,
      "text": "plataformas e confira quando o anúncio foi"
    },
    {
      "start": 58.98,
      "end": 59.83,
      "text": "publicado."
    },
    {
      "start": 60.44,
      "end": 61.43,
      "text": "Para uma versão de PC,"
    },
    {
      "start": 61.8,
      "end": 62.65,
      "text": "procure uma"
    },
    {
      "start": 62.8,
      "end": 64.89,
      "text": "comunicação que trate especificamente dela,"
    },
    {
      "start": 65.16,
      "end": 67.39,
      "text": "sem completar a lacuna por conta própria."
    },
    {
      "start": 68.48,
      "end": 69.95,
      "text": "O erro pode estar na associação,"
    },
    {
      "start": 70.4,
      "end": 72.43,
      "text": "mesmo quando cada pedaço parece legítimo."
    },
    {
      "start": 73.34,
      "end": 74.29,
      "text": "Antes de compartilhar,"
    },
    {
      "start": 74.72,
      "end": 77.1,
      "text": "confira se data, versão e fonte pertencem"
    },
    {
      "start": 77.1,
      "end": 77.95,
      "text": "ao mesmo anúncio."
    },
    {
      "start": 78.68,
      "end": 79.77,
      "text": "É assim que..."
    }
  ]
}