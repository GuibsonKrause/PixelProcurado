  "captions": [
    {
      "start": 0.0,
      "end": 1.09,
      "text": "Raul sabe roubar."
    },
    {
      "start": 1.7,
      "end": 2.55,
      "text": "Mas sabe parar?"
    },
    {
      "start": 3.72,
      "end": 6.6,
      "text": "A apresentação oficial de GTA seis descreve"
    },
    {
      "start": 6.6,
      "end": 9.02,
      "text": "um assaltante experiente, com disposição"
    },
    {
      "start": 9.02,
      "end": 10.31,
      "text": "crescente pra arriscar."
    },
    {
      "start": 10.98,
      "end": 13.4,
      "text": "As duas características podem andar juntas,"
    },
    {
      "start": 13.4,
      "end": 15.17,
      "text": "e essa combinação merece atenção."
    },
    {
      "start": 16.14,
      "end": 18.56,
      "text": "Quem já escapou de vários problemas pode"
    },
    {
      "start": 18.56,
      "end": 20.01,
      "text": "aprender a reconhecer o perigo."
    },
    {
      "start": 20.9,
      "end": 23.08,
      "text": "Também pode começar a achar que sempre"
    },
    {
      "start": 23.08,
      "end": 23.93,
      "text": "vai dar um jeito."
    },
    {
      "start": 25.0,
      "end": 27.46,
      "text": "O currículo aumenta, e o senso de"
    },
    {
      "start": 27.46,
      "end": 29.13,
      "text": "limite resolve pedir demissão."
    },
    {
      "start": 30.16,
      "end": 32.54,
      "text": "Imagina alguém apresentando um plano perigoso"
    },
    {
      "start": 32.54,
      "end": 34.24,
      "text": "com a calma de quem está escolhendo"
    },
    {
      "start": 34.24,
      "end": 35.09,
      "text": "uma pizza."
    },
    {
      "start": 35.7,
      "end": 37.09,
      "text": "A tranquilidade convence."
    },
    {
      "start": 37.72,
      "end": 39.84,
      "text": "Até você perceber que o entregador tem"
    },
    {
      "start": 39.84,
      "end": 41.76,
      "text": "uma rota de volta mais bem definida"
    },
    {
      "start": 41.76,
      "end": 42.61,
      "text": "que a equipe."
    },
    {
      "start": 43.48,
      "end": 44.99,
      "text": "Essa situação é inventada."
    },
    {
      "start": 45.6,
      "end": 47.58,
      "text": "O perfil não entrega uma missão específica"
    },
    {
      "start": 47.58,
      "end": 50.16,
      "text": "nem autoriza colocar Jason e Lucia nesse"
    },
    {
      "start": 50.16,
      "end": 53.92,
      "text": "plano. Ele permite observar uma tensão entre"
    },
    {
      "start": 53.92,
      "end": 54.85,
      "text": "capacidade,"
    },
    {
      "start": 55.3,
      "end": 57.25,
      "text": "confiança e vontade de assumir riscos."
    },
    {
      "start": 58.2,
      "end": 59.73,
      "text": "Uma pergunta ajuda bastante:"
    },
    {
      "start": 60.64,
      "end": 61.57,
      "text": "quem propõe a ideia"
    },
    {
      "start": 62.02,
      "end": 63.53,
      "text": "também paga quando dá errado?"
    },
    {
      "start": 64.62,
      "end": 66.7,
      "text": "A resposta pode mudar nossa opinião sobre"
    },
    {
      "start": 66.7,
      "end": 67.85,
      "text": "a coragem daquela pessoa."
    },
    {
      "start": 68.9,
      "end": 71.14,
      "text": "Às vezes o discurso parece melhor porque"
    },
    {
      "start": 71.14,
      "end": 72.11,
      "text": "a conta ficou pra outra."
    },
    {
      "start": 73.38,
      "end": 75.3,
      "text": "Eu prestaria atenção no tanto no que"
    },
    {
      "start": 75.3,
      "end": 77.46,
      "text": "Raul sabe fazer quanto na hora em"
    },
    {
      "start": 77.46,
      "end": 78.26,
      "text": "que decide parar."
    },
    {
      "start": 78.26,
      "end": 81.38,
      "text": "A Experiência pode ser valiosa sem virar"
    },
    {
      "start": 81.38,
      "end": 82.55,
      "text": "certificado de prudência."
    },
    {
      "start": 83.0,
      "end": 83.85,
      "text": "Afinal..."
    }
  ]
}