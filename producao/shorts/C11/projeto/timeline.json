  "captions": [
    {
      "start": 0.0,
      "end": 1.32,
      "text": "Jason mora grátis."
    },
    {
      "start": 1.32,
      "end": 2.17,
      "text": "Mas"
    },
    {
      "start": 2.44,
      "end": 3.29,
      "text": "tem cobrança."
    },
    {
      "start": 3.74,
      "end": 5.64,
      "text": "Brian oferece a propriedade sem aluguel,"
    },
    {
      "start": 5.64,
      "end": 7.59,
      "text": "e Jason ajuda com cobranças."
    },
    {
      "start": 8.2,
      "end": 10.5,
      "text": "É o acordo descrito na apresentação oficial"
    },
    {
      "start": 10.5,
      "end": 11.49,
      "text": "de GTA seis."
    },
    {
      "start": 12.86,
      "end": 14.33,
      "text": "O boleto desapareceu;"
    },
    {
      "start": 14.98,
      "end": 16.53,
      "text": "a obrigação só mudou de formato."
    },
    {
      "start": 17.0,
      "end": 19.34,
      "text": "Ter um lugar pra morar resolve um"
    },
    {
      "start": 19.34,
      "end": 20.19,
      "text": "problema importante."
    },
    {
      "start": 20.8,
      "end": 21.65,
      "text": "Ao mesmo tempo,"
    },
    {
      "start": 21.9,
      "end": 23.97,
      "text": "liga Jason a pedidos e serviços."
    },
    {
      "start": 24.7,
      "end": 26.92,
      "text": "A relação fica mais interessante quando a"
    },
    {
      "start": 26.92,
      "end": 29.16,
      "text": "gente olha o que cada lado oferece"
    },
    {
      "start": 29.16,
      "end": 30.49,
      "text": "e espera receber."
    },
    {
      "start": 31.48,
      "end": 33.88,
      "text": "Imagina precisar recusar uma tarefa de alguém"
    },
    {
      "start": 33.88,
      "end": 36.09,
      "text": "que também resolve sua moradia."
    },
    {
      "start": 37.02,
      "end": 39.24,
      "text": "A conversa começa com um favor e"
    },
    {
      "start": 39.24,
      "end": 41.64,
      "text": "termina com você pensando onde vai guardar"
    },
    {
      "start": 41.64,
      "end": 42.49,
      "text": "as caixas."
    },
    {
      "start": 43.42,
      "end": 45.94,
      "text": "Essa situação é uma possibilidade que o"
    },
    {
      "start": 45.94,
      "end": 46.79,
      "text": "acordo sugere,"
    },
    {
      "start": 47.1,
      "end": 48.49,
      "text": "não uma cena anunciada."
    },
    {
      "start": 49.44,
      "end": 51.38,
      "text": "Também não prova que Brian vai trair"
    },
    {
      "start": 51.38,
      "end": 52.89,
      "text": "Jason ou tomar a casa."
    },
    {
      "start": 53.34,
      "end": 54.99,
      "text": "O que sabemos é a troca."
    },
    {
      "start": 55.7,
      "end": 57.64,
      "text": "A tensão vem da dificuldade que pode"
    },
    {
      "start": 57.64,
      "end": 59.17,
      "text": "existir em separar gratidão,"
    },
    {
      "start": 59.46,
      "end": 60.89,
      "text": "interesse e obrigação."
    },
    {
      "start": 61.94,
      "end": 64.5,
      "text": "É aquela oferta que parece leve enquanto"
    },
    {
      "start": 64.5,
      "end": 66.84,
      "text": "a pessoa está explicando e ganha peso"
    },
    {
      "start": 66.84,
      "end": 68.21,
      "text": "quando chega a sua vez de cumprir."
    },
    {
      "start": 68.82,
      "end": 69.67,
      "text": "Por isso,"
    },
    {
      "start": 69.84,
      "end": 71.72,
      "text": "o detalhe da moradia conta mais sobre"
    },
    {
      "start": 71.72,
      "end": 74.0,
      "text": "a relação do que simplesmente dizer que"
    },
    {
      "start": 74.0,
      "end": 75.29,
      "text": "os dois se conhecem."
    },
    {
      "start": 75.92,
      "end": 77.89,
      "text": "Quando alguém oferece e ajuda,"
    },
    {
      "start": 78.34,
      "end": 80.54,
      "text": "vale prestar atenção no pedido que acompanha"
    },
    {
      "start": 80.54,
      "end": 81.39,
      "text": "o pacote."
    },
    {
      "start": 81.66,
      "end": 83.58,
      "text": "Principalmente quando o pacote inclui a chave"
    },
    {
      "start": 83.58,
      "end": 84.43,
      "text": "da sua casa."
    },
    {
      "start": 84.66,
      "end": 85.51,
      "text": "Porque..."
    }
  ]
}