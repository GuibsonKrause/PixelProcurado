  "captions": [
    {
      "start": 0.0,
      "end": 2.14,
      "text": "Uma paisagem é enorme pode caber numa"
    },
    {
      "start": 2.14,
      "end": 3.51,
      "text": "conclusão pequena demais."
    },
    {
      "start": 4.26,
      "end": 6.03,
      "text": "Você olha uma imagem de GTA seis,"
    },
    {
      "start": 6.54,
      "end": 8.78,
      "text": "vê destinos diferentes e tenta calcular o"
    },
    {
      "start": 8.78,
      "end": 9.63,
      "text": "tamanho do mapa."
    },
    {
      "start": 10.02,
      "end": 11.15,
      "text": "Parece intuitivo:"
    },
    {
      "start": 11.6,
      "end": 12.45,
      "text": "quanto mais lugares,"
    },
    {
      "start": 12.82,
      "end": 13.67,
      "text": "maior o mundo."
    },
    {
      "start": 14.1,
      "end": 16.34,
      "text": "Só que uma lista de cenários não"
    },
    {
      "start": 16.34,
      "end": 19.02,
      "text": "informa automaticamente as distâncias que"
    },
    {
      "start": 19.02,
      "end": 19.87,
      "text": "existem entre eles."
    },
    {
      "start": 20.98,
      "end": 23.54,
      "text": "Mas o problema começa ainda antes da"
    },
    {
      "start": 23.54,
      "end": 24.39,
      "text": "medida."
    },
    {
      "start": 24.78,
      "end": 26.64,
      "text": "A imagem pode mostrar um lugar sem"
    },
    {
      "start": 26.64,
      "end": 27.65,
      "text": "revelar suas fronteiras."
    },
    {
      "start": 28.26,
      "end": 30.36,
      "text": "O que ficou fora do quadro continua"
    },
    {
      "start": 30.36,
      "end": 31.31,
      "text": "fora do quadro."
    },
    {
      "start": 31.92,
      "end": 33.9,
      "text": "Completar essa parte com imaginação pode"
    },
    {
      "start": 33.9,
      "end": 36.02,
      "text": "servir para uma teoria, desde que não"
    },
    {
      "start": 36.02,
      "end": 37.87,
      "text": "vire uma escala apresentada como fato."
    },
    {
      "start": 38.96,
      "end": 41.23,
      "text": "Agora acrescente os prédios:"
    },
    {
      "start": 42.02,
      "end": 43.94,
      "text": "enxergar uma fachada também não confirma"
    },
    {
      "start": 43.94,
      "end": 45.05,
      "text": "que o jogador poderá entrar."
    },
    {
      "start": 45.92,
      "end": 48.55,
      "text": "Presença visual e acesso são perguntas diferentes."
    },
    {
      "start": 49.38,
      "end": 51.34,
      "text": "A mesma cena pode sustentar a descrição"
    },
    {
      "start": 51.34,
      "end": 53.5,
      "text": "de um edifício e deixar sem resposta"
    },
    {
      "start": 53.5,
      "end": 55.07,
      "text": "tudo que acontece atrás da porta."
    },
    {
      "start": 55.92,
      "end": 58.1,
      "text": "Só que existe uma maneira simples de"
    },
    {
      "start": 58.1,
      "end": 58.95,
      "text": "melhorar análise."
    },
    {
      "start": 59.7,
      "end": 62.16,
      "text": "Para cada afirmação, procure a evidência"
    },
    {
      "start": 62.16,
      "end": 63.01,
      "text": "correspondente."
    },
    {
      "start": 63.76,
      "end": 66.16,
      "text": "Distância precisa de medida ou demonstração"
    },
    {
      "start": 66.16,
      "end": 67.01,
      "text": "adequada."
    },
    {
      "start": 67.66,
      "end": 70.56,
      "text": "Acesso precisa de indicação ou demonstração"
    },
    {
      "start": 70.56,
      "end": 71.41,
      "text": "de acesso."
    },
    {
      "start": 71.9,
      "end": 73.84,
      "text": "Uma imagem bonita não responde a todas"
    },
    {
      "start": 73.84,
      "end": 75.15,
      "text": "essas perguntas ao mesmo tempo."
    },
    {
      "start": 76.16,
      "end": 78.0,
      "text": "O ganho é perceber exatamente o que"
    },
    {
      "start": 78.0,
      "end": 80.63,
      "text": "foi revelado e onde começa a expectativa."
    },
    {
      "start": 81.26,
      "end": 83.47,
      "text": "Lugares variados já despertam curiosidade;"
    },
    {
      "start": 84.04,
      "end": 86.29,
      "text": "não precisamos acrescentar quilômetros inventados."
    },
    {
      "start": 87.12,
      "end": 89.27,
      "text": "Quando a promessa cresce além da evidência,"
    },
    {
      "start": 89.82,
      "end": 90.67,
      "text": "lembre que..."
    }
  ]
}