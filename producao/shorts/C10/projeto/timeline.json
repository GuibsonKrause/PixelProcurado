  "captions": [
    {
      "start": 0.0,
      "end": 2.43,
      "text": "GTA colocou propaganda na sua playlist."
    },
    {
      "start": 3.22,
      "end": 4.59,
      "text": "No GTA cinco de PC,"
    },
    {
      "start": 4.9,
      "end": 7.34,
      "text": "o modo self Radio mistura as faixas"
    },
    {
      "start": 7.34,
      "end": 10.21,
      "text": "escolhidas por você com locução e intervalos."
    },
    {
      "start": 10.84,
      "end": 12.96,
      "text": "Sua seleção começa a parecer uma estação"
    },
    {
      "start": 12.96,
      "end": 13.81,
      "text": "daquele mundo."
    },
    {
      "start": 14.94,
      "end": 16.81,
      "text": "Isso muda a sensação de estar ouvindo."
    },
    {
      "start": 17.42,
      "end": 19.62,
      "text": "Uma lista pessoal parece preparada só pra"
    },
    {
      "start": 19.62,
      "end": 20.44,
      "text": "você."
    },
    {
      "start": 20.44,
      "end": 21.53,
      "text": "Quando entra um locutor,"
    },
    {
      "start": 21.98,
      "end": 23.81,
      "text": "dá impressão de existir um público maior,"
    },
    {
      "start": 24.18,
      "end": 26.49,
      "text": "com outras pessoas acompanhando aquela transmissão."
    },
    {
      "start": 27.2,
      "end": 28.11,
      "text": "É engraçado:"
    },
    {
      "start": 28.48,
      "end": 30.12,
      "text": "fora do jogo, a gente paga pra"
    },
    {
      "start": 30.12,
      "end": 31.15,
      "text": "fugir de anúncio."
    },
    {
      "start": 31.58,
      "end": 34.12,
      "text": "Dentro de GTA, fica feliz porque a"
    },
    {
      "start": 34.12,
      "end": 36.29,
      "text": "propaganda deixou a cidade mais convincente."
    },
    {
      "start": 37.08,
      "end": 38.25,
      "text": "A paz durou pouco."
    },
    {
      "start": 38.62,
      "end": 40.61,
      "text": "O intervalo comercial encontrou outro caminho."
    },
    {
      "start": 41.62,
      "end": 44.08,
      "text": "E um anúncio fictício pode contar o"
    },
    {
      "start": 44.08,
      "end": 46.62,
      "text": "que aquele lugar valoriza ou o que"
    },
    {
      "start": 46.62,
      "end": 47.95,
      "text": "alguém está tentando vender."
    },
    {
      "start": 48.98,
      "end": 51.34,
      "text": "A rua fica na imagem, enquanto uma"
    },
    {
      "start": 51.34,
      "end": 53.64,
      "text": "parte da personalidade da cidade chega pelo"
    },
    {
      "start": 53.64,
      "end": 54.49,
      "text": "som."
    },
    {
      "start": 54.92,
      "end": 57.52,
      "text": "Estou falando da Self Radio de GTA"
    },
    {
      "start": 57.52,
      "end": 58.39,
      "text": "cinco no PC,"
    },
    {
      "start": 59.02,
      "end": 60.19,
      "text": "nesse modo específico."
    },
    {
      "start": 60.64,
      "end": 62.6,
      "text": "Isso não confirma a mesma função em"
    },
    {
      "start": 62.6,
      "end": 65.08,
      "text": "GTA seis nem descreve todos os modos"
    },
    {
      "start": 65.08,
      "end": 66.29,
      "text": "de reprodução disponíveis."
    },
    {
      "start": 66.98,
      "end": 69.25,
      "text": "O detalhe interessante é a transformação:"
    },
    {
      "start": 70.08,
      "end": 72.82,
      "text": "você entrega músicas pessoais e recebe algo"
    },
    {
      "start": 72.82,
      "end": 74.61,
      "text": "que parece existir dentro do jogo."
    },
    {
      "start": 75.3,
      "end": 76.84,
      "text": "Não é só a faixa entre uma"
    },
    {
      "start": 76.84,
      "end": 77.69,
      "text": "curva e outra."
    },
    {
      "start": 78.04,
      "end": 80.15,
      "text": "Tem uma cidade falando nos intervalos."
    },
    {
      "start": 80.52,
      "end": 81.37,
      "text": "Afinal..."
    }
  ]
}