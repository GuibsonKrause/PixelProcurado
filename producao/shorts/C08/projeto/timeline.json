  "captions": [
    {
      "start": 0.0,
      "end": 2.45,
      "text": "A iguana já virou síndica daqui."
    },
    {
      "start": 2.86,
      "end": 4.76,
      "text": "Pelo menos é a impressão dessa imagem"
    },
    {
      "start": 4.76,
      "end": 5.95,
      "text": "das Leonida Keys:"
    },
    {
      "start": 6.44,
      "end": 8.46,
      "text": "ela está no asfalto, com pessoas ao"
    },
    {
      "start": 8.46,
      "end": 10.9,
      "text": "redor, tranquila como quem comprou o lote"
    },
    {
      "start": 10.9,
      "end": 11.75,
      "text": "antes de todo mundo."
    },
    {
      "start": 12.6,
      "end": 14.18,
      "text": "A gente chega olhando a paisagem e"
    },
    {
      "start": 14.18,
      "end": 16.67,
      "text": "encontra a administração local tomando sol."
    },
    {
      "start": 17.4,
      "end": 19.04,
      "text": "Falta só pedir o número da reserva"
    },
    {
      "start": 19.04,
      "end": 20.2,
      "text": "e informar que o horário de visita"
    },
    {
      "start": 20.2,
      "end": 21.05,
      "text": "acabou."
    },
    {
      "start": 21.72,
      "end": 24.18,
      "text": "O detalhe funciona porque dá uma situação"
    },
    {
      "start": 24.18,
      "end": 25.03,
      "text": "pra imaginar."
    },
    {
      "start": 25.44,
      "end": 27.02,
      "text": "Você não vê apenas uma rua bonita."
    },
    {
      "start": 27.02,
      "end": 29.0,
      "text": "Encontra um animal no lugar por onde"
    },
    {
      "start": 29.0,
      "end": 31.14,
      "text": "as pessoas passam, e olhar quer saber"
    },
    {
      "start": 31.14,
      "end": 32.27,
      "text": "como aquela cena continua."
    },
    {
      "start": 33.16,
      "end": 35.46,
      "text": "Agora imagina o mesmo quadro sem a"
    },
    {
      "start": 35.46,
      "end": 36.31,
      "text": "iguana."
    },
    {
      "start": 36.46,
      "end": 37.49,
      "text": "É um exercício nosso,"
    },
    {
      "start": 37.8,
      "end": 38.97,
      "text": "não outra captura do jogo."
    },
    {
      "start": 40.06,
      "end": 41.01,
      "text": "A rua continuaria lá,"
    },
    {
      "start": 41.46,
      "end": 43.26,
      "text": "mas perderia o personagem que faz a"
    },
    {
      "start": 43.26,
      "end": 44.76,
      "text": "gente prestar atenção no espaço de outro"
    },
    {
      "start": 44.76,
      "end": 45.61,
      "text": "jeito."
    },
    {
      "start": 45.78,
      "end": 47.28,
      "text": "Isso não confirma que o bicho bloqueia"
    },
    {
      "start": 47.28,
      "end": 49.86,
      "text": "carros, reage ao jogador ou participa de"
    },
    {
      "start": 49.86,
      "end": 50.71,
      "text": "uma missão."
    },
    {
      "start": 50.8,
      "end": 52.43,
      "text": "A foto mostra a presença dele."
    },
    {
      "start": 53.06,
      "end": 54.84,
      "text": "O comportamento precisa de outra evidência,"
    },
    {
      "start": 54.84,
      "end": 57.08,
      "text": "por mais convincente que esteja essa pose"
    },
    {
      "start": 57.08,
      "end": 58.59,
      "text": "de proprietário."
    },
    {
      "start": 59.14,
      "end": 61.29,
      "text": "A graça está no tamanho da participação:"
    },
    {
      "start": 61.86,
      "end": 63.76,
      "text": "um animal pequeno dá personalidade a uma"
    },
    {
      "start": 63.76,
      "end": 64.63,
      "text": "imagem inteira."
    },
    {
      "start": 65.32,
      "end": 67.1,
      "text": "Entre tanta água e tanto horizonte nas"
    },
    {
      "start": 67.1,
      "end": 69.14,
      "text": "Keys, foi o sujeito deitado no asfalto"
    },
    {
      "start": 69.14,
      "end": 70.49,
      "text": "que conseguiu comandar o quadro."
    },
    {
      "start": 71.24,
      "end": 72.12,
      "text": "Afinal..."
    }
  ]
}