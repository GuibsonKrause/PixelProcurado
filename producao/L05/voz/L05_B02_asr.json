  "segments": [
    {
      "start": 0.0,
      "end": 2.24,
      "text": "Agora muda para a praia de Vice City."
    },
    {
      "start": 2.72,
      "end": 6.7,
      "text": "Tem uma pessoa tomando o sol mais perto da câmera, um casal andando,"
    },
    {
      "start": 7.26,
      "end": 12.14,
      "text": "outras pessoas espalhadas e um homem com o detector perto do posto de salva vidas."
    },
    {
      "start": 13.06,
      "end": 15.2,
      "text": "Se olhar consegue fazer várias paradas."
    },
    {
      "start": 16.02,
      "end": 17.86,
      "text": "O detector é um detalhe ótimo."
    },
    {
      "start": 18.46,
      "end": 20.98,
      "text": "Ele sugere uma atividade diferente no meio do passeio."
    },
    {
      "start": 21.62,
      "end": 25.16,
      "text": "A gente olha e já imagina o sujeito esperando encontrar uma joia,"
    },
    {
      "start": 25.36,
      "end": 28.06,
      "text": "enquanto a praia oferece a décima tampinha do dia."
    },
    {
      "start": 28.76,
      "end": 32.2,
      "text": "Essa história é nossa imaginação trabalhando em cima do objeto,"
    },
    {
      "start": 32.6,
      "end": 33.7,
      "text": "não uma missão anunciada."
    },
    {
      "start": 34.52,
      "end": 35.98,
      "text": "O que está visível é suficiente."
    },
    {
      "start": 36.88,
      "end": 40.36,
      "text": "Pessoas com poses e ocupações diferentes dentro do mesmo quadro."
    },
    {
      "start": 41.28,
      "end": 43.96,
      "text": "Na foto do ciclista acompanhamos uma ação."
    },
    {
      "start": 44.88,
      "end": 48.02,
      "text": "Nessa praia exploramos várias pequenas situações."
    },
    {
      "start": 48.76,
      "end": 50.6,
      "text": "Essa é a diferença que estamos comparando."
    },
    {
      "start": 51.28,
      "end": 55.08,
      "text": "Ela não prova que GTA 6 inteiro tem determinada quantidade de pessoas"
    },
    {
      "start": 55.08,
      "end": 57.8,
      "text": "ou que a praia de GTA 5 sempre fica vazia."
    },
    {
      "start": 58.06,
      "end": 60.38,
      "text": "São fotos escolhidas para a divulgação."
    },
    {
      "start": 61.12,
      "end": 64.02,
      "text": "Elas mostram o que cada enquadramento decidiu destacar."
    },
    {
      "start": 64.82,
      "end": 65.98,
      "text": "E com os carros."
    },
    {
      "start": 66.68,
      "end": 70.1,
      "text": "A imagem do Tita em GTA 5 chega bem perto da traseira."
    },
    {
      "start": 70.68,
      "end": 73.9,
      "text": "O aeroafólio chama atenção, tem fumaça junto dos pneus,"
    },
    {
      "start": 74.32,
      "end": 75.3,
      "text": "e a rua fica atrás."
    },
    {
      "start": 76.06,
      "end": 77.4,
      "text": "A máquina domina ao quadro."
    }
  ]
}