  "segments": [
    {
      "start": 0.0,
      "end": 5.14,
      "text": "Se a pergunta é sobre a aparência do jogo, a captura permite observar os detalhes daquele quadro."
    },
    {
      "start": 5.62,
      "end": 8.3,
      "text": "O desenho mostra como o artista representou os personagens."
    },
    {
      "start": 8.94,
      "end": 13.62,
      "text": "Usar o post é para avaliar os gráficos, seria como o corretor mostrar a planta do apartamento"
    },
    {
      "start": 13.62,
      "end": 15.48,
      "text": "e a gente elogiava a ventilação."
    },
    {
      "start": 16.16,
      "end": 19.02,
      "text": "Tem uma certa desenhada, deve entrar um vento maravilhoso."
    },
    {
      "start": 19.92,
      "end": 21.44,
      "text": "E valeu cuidado do outro lado."
    },
    {
      "start": 22.02,
      "end": 24.04,
      "text": "Uma captura de tela mostra um instante."
    },
    {
      "start": 24.62,
      "end": 28.76,
      "text": "Sozinha ela não demonstra como o jogo roda em movimento ou responde ao controle."
    },
    {
      "start": 28.76,
      "end": 32.98,
      "text": "Para isso, a gente precisa olhar o material que mostra justamente essas coisas."
    },
    {
      "start": 33.9,
      "end": 35.36,
      "text": "Gostar da imagem é fácil."
    },
    {
      "start": 35.78,
      "end": 39.44,
      "text": "Saber o que ela prova exige olhar de onde veio e para que serve."
    },
    {
      "start": 40.22,
      "end": 44.64,
      "text": "No trailer 2, a Rockstar confirmou a mistura de gameplay e cenas prontas."
    },
    {
      "start": 45.24,
      "end": 49.72,
      "text": "O PS5 foi o aparelho da gravação e o Xbox também está na lista de plataformas."
    },
    {
      "start": 50.46,
      "end": 53.7,
      "text": "Na biblioteca, desenho e captura ficam separados."
    },
    {
      "start": 54.34,
      "end": 57.04,
      "text": "Três checagem simples antes de sair distribuindo certeza."
    },
    {
      "start": 57.94,
      "end": 61.66,
      "text": "Qual o detalhe do material oficial que queremos examinar no próximo vídeo?"
    },
    {
      "start": 62.2,
      "end": 63.0,
      "text": "Manda nos comentários."
    },
    {
      "start": 63.58,
      "end": 64.84,
      "text": "Aqui é o Pixel Procurado."
    },
    {
      "start": 65.38,
      "end": 69.2,
      "text": "A gente pode se empolgar, só traz a prudência de volta antes de apertar publicar."
    }
  ]
}