  "segments": [
    {
      "start": 0.0,
      "end": 4.68,
      "text": "gravar um churrasco com o iPhone não transforma a linguiça exclusiva da Apple,"
    },
    {
      "start": 5.3,
      "end": 8.9,
      "text": "embora vender o pão de alho separado fosse bem coerente com a marca."
    },
    {
      "start": 10.08,
      "end": 12.56,
      "text": "O destaque da Uprestation pode chamar mais atenção,"
    },
    {
      "start": 13.0,
      "end": 15.36,
      "text": "só que o nome do Xbox continua ali."
    },
    {
      "start": 15.96,
      "end": 18.12,
      "text": "Para resolver essa dúvida basta olhar a lista completa."
    },
    {
      "start": 19.06,
      "end": 23.08,
      "text": "Eu quero jogar GTA, defender multinacional de graça já é um segundo emprego."
    },
    {
      "start": 24.22,
      "end": 27.78,
      "text": "E ter uma terceira confusão que a própria biblioteca da Rockstar ajuda a evitar."
    },
    {
      "start": 28.36,
      "end": 30.38,
      "text": "Misturar a ilustração com a imagem do jogo."
    },
    {
      "start": 31.04,
