#!/bin/sh
# Barra midia e arquivos grandes no Git (limite gratuito do GitHub com folga).
# Regras: nenhum arquivo > 5 MB, nenhuma extensao de midia, repo total <= 100 MB.
# Midia vai para o Google Drive: py -3.12 automacao/armazenamento.py arquivar <pasta> --executar
# Confere o indice inteiro em uma unica chamada (rapido mesmo com milhares de arquivos).
LIMITE_ARQ=$((5 * 1024 * 1024))
LIMITE_REPO=$((100 * 1024 * 1024))
rel=$(git ls-files -s | sed 's/^[0-9]* \([0-9a-f]*\) [0-9]*\t/\1 /' \
  | git cat-file --batch-check='%(objectsize) %(rest)' \
  | awk -v la="$LIMITE_ARQ" -v lr="$LIMITE_REPO" '
      { tam = $1; caminho = substr($0, index($0, " ") + 1); total += tam; low = tolower(caminho) }
      low ~ /\.(mp4|mov|mkv|webm|ts|wav|mp3|m4a|f32|mbtree|zip|7z|pdf)$/ { print "BLOQUEADO (midia -> Drive): " caminho; ruim = 1 }
      tam > la { printf "BLOQUEADO (> 5 MB: %.1f MB): %s\n", tam / 1048576, caminho; ruim = 1 }
      END { if (total > lr) { printf "BLOQUEADO: versionados somam %.0f MB (limite 100 MB)\n", total / 1048576; ruim = 1 }
            if (ruim) print "FALHA" }')
if printf '%s' "$rel" | grep -q FALHA; then
  printf '%s\n' "$rel" | grep -v '^FALHA$'
  echo "Ajuste o .gitignore ou arquive a midia no Drive. (Pular a regra com --no-verify so com autorizacao do usuario)"
  exit 1
fi
exit 0
